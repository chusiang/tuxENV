# - Theme ------------------------------------------------------------

font-family = SauceCodePro Nerd Font
font-size = 18

theme = dark:Tomorrow Night Eighties,light:Tomorrow
background-opacity = 0.95

# gtk-titlebar = false

# - NeoVim support ---------------------------------------------------

term = xterm-ghostty
shell-integration = bash
shell-integration-features = no-cursor,sudo,title
cursor-style = block

# - Keybind ----------------------------------------------------------

### Copy & Paste
#
# keybind = alt+c=copy_to_clipboard:plain
keybind = alt+v=paste_from_clipboard

### Tmux
#
keybind = cmd+j=text:\x01\x6e
keybind = cmd+k=text:\x01\x70

### Split switch with Vim style
#
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+l=goto_split:right
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+j=goto_split:down

